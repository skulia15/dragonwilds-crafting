---
import Search from "../components/Search.astro";
import { support } from "../data/site";
import { fetchedAt } from "../lib/db";
import { href } from "../lib/wiki";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	/** Hide the header search (the home page renders its own, larger one). */
	hideSearch?: boolean;
	robots?: string;
	structuredData?: Record<string, unknown>;
}

const { title, description, hideSearch = false, robots = "index, follow", structuredData } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// One branded 1200×630 card for every page (source: assets/og-image.svg); item icons are too small for previews.
const ogImage = new URL(href("/og-image.png"), Astro.site).href;
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const analyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Skúli Arnarsson" />
		<meta name="robots" content={robots} />
		{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
		{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Dragonwilds Crafting" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Dragonwilds Crafting — recipes and crafting trees for RuneScape: Dragonwilds" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="icon" href={href("/favicon.ico")} sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
		<link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
		<meta name="theme-color" content="#121417" />
		<link rel="sitemap" href={href("/sitemap-index.xml")} />
		{structuredData && (
			<script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
		)}
		{analyticsToken && (
			<script
				is:inline
				defer
				src="https://static.cloudflareinsights.com/beacon.min.js"
				data-cf-beacon={JSON.stringify({ token: analyticsToken })}
			/>
		)}
	</head>
	<body>
		<header class="site-header">
			<div class="inner">
				<a class="brand" href={href("/")}>
					<span class="brand-mark" aria-hidden="true">⚒</span>
					<span>Dragonwilds <em>Crafting</em></span>
				</a>
				<nav class="nav" aria-label="Main">
					<a href={href("/equipment/")}>Equipment</a>
					<a href={href("/planner/")}>Planner</a>
					<a href={href("/whats-new/")}>What's new</a>
				</nav>
				{!hideSearch && <Search />}
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>
				Data and images from the <a href="https://dragonwilds.runescape.wiki/">RuneScape: Dragonwilds Wiki</a>,
				licensed <a href="https://creativecommons.org/licenses/by-nc-sa/3.0/">CC BY-NC-SA 3.0</a>. Data updated {
					new Date(fetchedAt).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
				}.
			</p>
			{
				support.supportUrl && (
					<p class="support">
						Free &amp; ad-free.{" "}
						{support.costs.amount > 0 &&
							`${support.costs.year} costs (${support.costs.label}): ${support.costs.currency}${support.costs.amount} — ${
								support.costs.covered >= support.costs.amount
									? "covered ✓"
									: `${support.costs.currency}${support.costs.covered} covered so far`
							}. `}
						<a href={support.supportUrl} rel="noopener">Chip in to keep it running</a>
						{support.sponsorsUrl && (
							<>
								{" "}or{" "}
								<a href={support.sponsorsUrl} rel="noopener">
									sponsor on GitHub
								</a>
							</>
						)}
					</p>
				)
			}
			<p>Built by Skúli Arnarsson. Fan-made, not affiliated with Jagex. RuneScape is a trademark of Jagex Ltd.</p>
		</footer>
	</body>
</html>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgb(18 20 23 / 0.9);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
	}
	.inner {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0.6rem 1rem;
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--serif);
		font-size: 1.15rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.brand em {
		font-style: normal;
		color: var(--gold);
	}
	.brand-mark {
		color: var(--gold);
		font-size: 1.3rem;
	}
	.nav {
		display: flex;
		gap: 1rem;
		font-size: 0.92rem;
	}
	.nav a {
		color: var(--text-dim);
		text-decoration: none;
		white-space: nowrap;
	}
	.nav a:hover {
		color: var(--gold);
	}
	.support {
		color: var(--text);
	}
	.inner :global(.search) {
		flex: 1;
		max-width: 480px;
		margin-left: auto;
	}
	@media (max-width: 560px) {
		.inner {
			flex-wrap: wrap;
			gap: 0.5rem 1rem;
		}
		.nav {
			margin-left: auto;
		}
		.inner :global(.search) {
			flex-basis: 100%;
			max-width: none;
		}
	}
	.site-footer {
		border-top: 1px solid var(--line);
		padding: 1.25rem 1rem 2rem;
		text-align: center;
		font-size: 0.8rem;
		color: var(--text-dim);
	}
	.site-footer p {
		margin: 0.25rem 0;
	}
	.site-footer a {
		color: var(--text-dim);
	}
</style>
