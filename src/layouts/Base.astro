---
import Search from "../components/Search.astro";
import { fetchedAt } from "../lib/db";
import { href } from "../lib/wiki";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	/** Hide the header search (the home page renders its own, larger one). */
	hideSearch?: boolean;
	image?: string | null;
	robots?: string;
	structuredData?: Record<string, unknown>;
}

const { title, description, hideSearch = false, image, robots = "index, follow", structuredData } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const analyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Skúli Arnarsson" />
		<meta name="robots" content={robots} />
		{googleVerification && <meta name="google-site-verification" content={googleVerification} />}
		{bingVerification && <meta name="msvalidate.01" content={bingVerification} />}
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Dragonwilds Crafting" />
		{image && <meta property="og:image" content={image} />}
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{image && <meta name="twitter:image" content={image} />}
		<link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
		<link rel="sitemap" href={href("/sitemap-index.xml")} />
		<link rel="preconnect" href="https://dragonwilds.runescape.wiki" />
		{structuredData && (
			<script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
		)}
		{analyticsToken && (
			<script
				is:inline
				defer
				src="https://static.cloudflareinsights.com/beacon.min.js"
				data-cf-beacon={JSON.stringify({ token: analyticsToken })}
			/>
		)}
	</head>
	<body>
		<header class="site-header">
			<div class="inner">
				<a class="brand" href={href("/")}>
					<span class="brand-mark" aria-hidden="true">⚒</span>
					<span>Dragonwilds <em>Crafting</em></span>
				</a>
				{!hideSearch && <Search />}
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<p>
				Data and images from the <a href="https://dragonwilds.runescape.wiki/">RuneScape: Dragonwilds Wiki</a>,
				licensed <a href="https://creativecommons.org/licenses/by-nc-sa/3.0/">CC BY-NC-SA 3.0</a>. Data updated {
					new Date(fetchedAt).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })
				}.
			</p>
			<p>Built by Skúli Arnarsson. Fan-made, not affiliated with Jagex. RuneScape is a trademark of Jagex Ltd.</p>
		</footer>
	</body>
</html>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgb(18 20 23 / 0.9);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
	}
	.inner {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0.6rem 1rem;
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--serif);
		font-size: 1.15rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.brand em {
		font-style: normal;
		color: var(--gold);
	}
	.brand-mark {
		color: var(--gold);
		font-size: 1.3rem;
	}
	.inner :global(.search) {
		flex: 1;
		max-width: 480px;
		margin-left: auto;
	}
	@media (max-width: 560px) {
		.brand span:last-child {
			display: none;
		}
	}
	.site-footer {
		border-top: 1px solid var(--line);
		padding: 1.25rem 1rem 2rem;
		text-align: center;
		font-size: 0.8rem;
		color: var(--text-dim);
	}
	.site-footer p {
		margin: 0.25rem 0;
	}
	.site-footer a {
		color: var(--text-dim);
	}
</style>
