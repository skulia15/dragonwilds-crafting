---
import ItemCard from "../../components/ItemCard.astro";
import ItemIcon from "../../components/ItemIcon.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import Base from "../../layouts/Base.astro";
import { getCategory, getCraftedAt, getItem, getRecipesTaughtBy, type Item, items, subgraph } from "../../lib/db";
import { gatherSummary, plan, renderRaw, renderSteps, renderTree } from "../../lib/tree";
import { href, iconUrl, wikiUrl } from "../../lib/wiki";
import "../../styles/tree.css";

export function getStaticPaths() {
	return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props {
	item: Item;
}
const { item } = Astro.props;
const category = getCategory(item.category);
const primary = item.recipes[0];
// A tree only adds anything over the recipe cards if some recipe has a craftable ingredient.
const hasSubRecipes = item.recipes.some((r) => r.materials.some((m) => getItem(m.slug).recipes.length > 0));
const graph = hasSubRecipes ? subgraph(item.slug) : null;
const craftedHere = getCraftedAt(item.slug);
const taughtRecipes = getRecipesTaughtBy(item.slug);
const usedIn = item.usedIn.map(getItem);
const hasSources = item.drops.length > 0 || item.shops.length > 0;
const initialPlan = graph && plan(graph, [{ slug: item.slug, qty: 1 }], {});

const title = primary
	? `${item.name} — How to Craft, Recipe & Materials | Dragonwilds`
	: `${item.name} — Where to Find | Dragonwilds`;
const truncate = (s: string, n: number) => (s.length > n ? `${s.slice(0, n - 1).trimEnd()}…` : s);
const description = primary
	? truncate(
			`How to craft ${item.name} in RuneScape: Dragonwilds: ${primary.materials
				.map((m) => `${m.qty}× ${m.label}`)
				.join(", ")}${primary.station ? ` at the ${primary.station.name}` : ""}. Full recipe and material tree.`,
			160,
		)
	: truncate(item.extract || item.description || `Where to find ${item.name} in RuneScape: Dragonwilds.`, 160);
const pageUrl = new URL(href(`/item/${item.slug}/`), Astro.site).href;
const categoryUrl = category && new URL(href(`/category/${category.slug}/`), Astro.site).href;
// Social/structured-data images must be absolute.
const image = item.icon && new URL(iconUrl(item.icon)!, Astro.site).href;
const breadcrumbs = [
	{ "@type": "ListItem", position: 1, name: "Home", item: new URL(href("/"), Astro.site).href },
	...(category && categoryUrl
		? [{ "@type": "ListItem", position: 2, name: category.name, item: categoryUrl }]
		: []),
	{ "@type": "ListItem", position: category ? 3 : 2, name: item.name, item: pageUrl },
];
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebPage",
			"@id": pageUrl,
			url: pageUrl,
			name: title,
			description,
			...(image && { primaryImageOfPage: { "@type": "ImageObject", url: image } }),
		},
		{ "@type": "BreadcrumbList", itemListElement: breadcrumbs },
	],
};
---

<Base title={title} description={description} structuredData={structuredData}>
	<nav class="crumbs small" aria-label="Breadcrumb">
		<a href={href("/")}>Home</a>
		<span aria-hidden="true">/</span>
		{category && <a href={href(`/category/${category.slug}/`)}>{category.name}</a>}
	</nav>

	<header class="item-head">
		<div class="item-icon"><ItemIcon file={item.icon} size={72} /></div>
		<div>
			<h1>{item.name}</h1>
			<div class="tags">
				{item.type && <span class="badge">{item.type}</span>}
				{item.power != null && <span class="badge power">Power level {item.power}</span>}
				<span class:list={["badge", { craftable: primary }]}>{primary ? "Craftable" : "Not craftable"}</span>
				<a class="small" href={wikiUrl(item.wiki)} rel="noopener">View on wiki ↗</a>
			</div>
			{
				primary && (
					<div class="plan-actions">
						<label class="qty-field">
							<span>Quantity</span>
							<input type="number" id="craft-qty" min="1" max="9999" value="1" inputmode="numeric" />
						</label>
						<button type="button" class="btn" id="add-to-planner" data-slug={item.slug}>
							Add to planner
						</button>
						<span class="small muted" id="planner-status" aria-live="polite" />
					</div>
				)
			}
			{
				item.unlockedBy.length > 0 && (
					<ul class="unlocks">
						{item.unlockedBy.map((u) => (
							<li title={u.description}>
								Unlocked at <strong>{u.skill}{u.level != null && ` ${u.level}`}</strong> —{" "}
								<a href={wikiUrl(u.perk)} rel="noopener">
									{u.perk}
								</a>
							</li>
						))}
					</ul>
				)
			}
			{item.description && <p class="flavour">“{item.description}”</p>}
		</div>
	</header>

	{item.extract && <p class="extract">{item.extract}</p>}

	{
		(item.stats.length > 0 || item.weight != null) && (
			<section>
				<h2>Stats</h2>
				<dl class="stats">
					{item.power != null && (
						<div>
							<dt>Power level</dt>
							<dd>
								<a href={href(`/equipment/#power-${item.power}`)}>{item.power}</a>
							</dd>
						</div>
					)}
					{item.stats.map((s) => (
						<div>
							<dt>{s.label}</dt>
							<dd>{s.value}</dd>
						</div>
					))}
					{item.weight != null && (
						<div>
							<dt>Weight</dt>
							<dd>{item.weight}</dd>
						</div>
					)}
				</dl>
			</section>
		)
	}

	{
		primary && (
			<section>
				<h2>
					How to craft
					{item.recipes.length > 1 && <span class="muted small"> · {item.recipes.length} recipes</span>}
				</h2>
				<div class="recipes">
					{item.recipes.map((r) => (
						<div>
							{r.outputLabel !== item.name && <p class="variant small muted">Makes: {r.outputLabel}</p>}
							<RecipeCard recipe={r} />
						</div>
					))}
				</div>
			</section>
		)
	}

	{
		graph && initialPlan && (
			<section class="breakdown" id="breakdown">
				<h2>Crafting tree</h2>
				<p class="small muted">
					Everything needed for the quantity above. Items with several recipes can be switched — your choice is
					remembered on every page.
				</p>
				<p class="pref-note small" id="pref-note" hidden>
					Using your recipe choices. <button type="button" id="pref-reset">Reset all to default</button>
				</p>
				<div class="tree-root" id="craft-tree" set:html={renderTree(graph, item.slug, {})} />
				<div class="cols">
					<div>
						<h3 class="list-head">
							Shopping list
							<button type="button" class="btn ghost small" id="copy-list">Copy list</button>
						</h3>
						<p class="small muted" id="gather-summary" set:html={gatherSummary(graph, initialPlan.raw)} />
						<ul class="totals" id="craft-totals" set:html={renderRaw(graph, initialPlan.raw, {})} />
					</div>
					<div>
						<h3>Crafting steps</h3>
						<p class="small muted">In order, ingredients first. Enter what you already have to skip it.</p>
						<ol class="steps" id="craft-steps" set:html={renderSteps(graph, initialPlan.steps, {})} />
					</div>
				</div>
				<p class="small muted" id="inventory-note" hidden>
					Counting what you have — shared with the planner and other pages.{" "}
					<button type="button" class="link-btn" id="inventory-reset">Clear inventory</button>
				</p>
				<script type="application/json" id="craft-graph" data-root={item.slug} data-name={item.name} set:html={JSON.stringify(graph).replace(/</g, "\\u003c")} />
			</section>
		)
	}

	{
		(hasSources || !primary) && (
			<section>
				<h2>Where to find</h2>
				{!hasSources && (
					<p class="muted">
						No drop or shop data on the wiki yet — see the <a href={wikiUrl(item.wiki)}>wiki page</a> for details.
					</p>
				)}
				{item.drops.length > 0 && (
					<table>
						<thead>
							<tr>
								<th>Source</th>
								<th>Quantity</th>
								<th>Rarity</th>
							</tr>
						</thead>
						<tbody>
							{item.drops.map((d) => (
								<tr>
									<td>
										<a href={wikiUrl(d.source)} rel="noopener">
											{d.source}
										</a>
									</td>
									<td>{d.qty}</td>
									<td>{d.rarity}</td>
								</tr>
							))}
						</tbody>
					</table>
				)}
				{item.shops.length > 0 && (
					<>
						<h3>Shops</h3>
						<table>
							<thead>
								<tr>
									<th>Seller</th>
									<th>Price</th>
								</tr>
							</thead>
							<tbody>
								{item.shops.map((s) => (
									<tr>
										<td>
											<a href={wikiUrl(s.seller)} rel="noopener">
												{s.seller}
											</a>
										</td>
										<td>{s.cost != null ? `${s.cost} ${s.currency ?? ""}` : "—"}</td>
									</tr>
								))}
							</tbody>
						</table>
					</>
				)}
			</section>
		)
	}

	{
		taughtRecipes.length > 0 && (
			<section>
				<h2>
					Unlocks recipe for <span class="muted small">· {taughtRecipes.length}</span>
				</h2>
				<div class="grid">
					{taughtRecipes.map((i) => (
						<ItemCard item={i} />
					))}
				</div>
			</section>
		)
	}

	{
		craftedHere.length > 0 && (
			<section>
				<h2>
					Crafted at this station <span class="muted small">· {craftedHere.length}</span>
				</h2>
				<div class="grid">
					{craftedHere.map((i) => (
						<ItemCard item={i} sub={getCategory(i.category)?.name} />
					))}
				</div>
			</section>
		)
	}

	{
		usedIn.length > 0 && (
			<section>
				<h2>
					Used to craft <span class="muted small">· {usedIn.length}</span>
				</h2>
				<div class="grid">
					{usedIn.map((i) => (
						<ItemCard item={i} />
					))}
				</div>
			</section>
		)
	}
</Base>


<script>
	import { bindInventory, copyText, INVENTORY_KEY, loadHave, saveHave } from "../../lib/inventory";
	import { addToPlanner, clampQty } from "../../lib/planner";
	import { loadPrefs, PREFS_KEY, savePrefs } from "../../lib/prefs";
	import { href } from "../../lib/wiki";
	import {
		gatherSummary,
		type Graph,
		plan,
		planText,
		renderRaw,
		renderSteps,
		renderTree,
		usesCustomRecipes,
	} from "../../lib/tree";

	const qtyInput = document.getElementById("craft-qty") as HTMLInputElement | null;
	const qty = () => clampQty(qtyInput?.value);

	const addBtn = document.getElementById("add-to-planner");
	const status = document.getElementById("planner-status");
	addBtn?.addEventListener("click", () => {
		addToPlanner(addBtn.dataset.slug!, qty());
		if (status) status.innerHTML = `Added ✓ <a href="${href("/planner/")}">Open planner</a>`;
	});

	const data = document.getElementById("craft-graph");
	const treeEl = document.getElementById("craft-tree");
	const totalsEl = document.getElementById("craft-totals");
	const stepsEl = document.getElementById("craft-steps");
	const summaryEl = document.getElementById("gather-summary");
	const note = document.getElementById("pref-note");
	const inventoryNote = document.getElementById("inventory-note");
	if (data && treeEl && totalsEl && stepsEl && summaryEl && note && inventoryNote) {
		const graph = JSON.parse(data.textContent!) as Graph;
		const root = data.dataset.root!;

		const current = () => plan(graph, [{ slug: root, qty: qty() }], loadPrefs(), loadHave());
		const render = () => {
			const prefs = loadPrefs();
			const have = loadHave();
			// Keep the player's expand/collapse state across re-renders.
			const openState = new Map(
				[...treeEl.querySelectorAll<HTMLDetailsElement>("details[data-path]")].map((d) => [d.dataset.path, d.open]),
			);
			treeEl.innerHTML = renderTree(graph, root, prefs, qty(), have);
			for (const d of treeEl.querySelectorAll<HTMLDetailsElement>("details[data-path]")) {
				const open = openState.get(d.dataset.path);
				if (open !== undefined) d.open = open;
			}
			const p = current();
			totalsEl.innerHTML = renderRaw(graph, p.raw, have);
			stepsEl.innerHTML = renderSteps(graph, p.steps, have);
			summaryEl.innerHTML = gatherSummary(graph, p.raw);
			note.hidden = !usesCustomRecipes(graph, root, prefs);
			inventoryNote.hidden = !Object.keys(have).some((s) => s in graph);
		};
		bindInventory(document.getElementById("breakdown")!, render);
		document.getElementById("inventory-reset")?.addEventListener("click", () => {
			saveHave({});
			render();
		});
		const copyBtn = document.getElementById("copy-list")!;
		copyBtn.addEventListener("click", () =>
			copyText(planText(graph, `${qty()}× ${data.dataset.name} — Dragonwilds`, current()), copyBtn),
		);

		treeEl.addEventListener("change", (e) => {
			const select = e.target as HTMLSelectElement;
			const slug = select.dataset.slug;
			if (!slug) return;
			const prefs = loadPrefs();
			// Choosing the default clears the pref, so future default changes in the data apply.
			if (select.value === graph[slug].recipes[0].id) delete prefs[slug];
			else prefs[slug] = select.value;
			savePrefs(prefs);
			render();
		});
		document.getElementById("pref-reset")?.addEventListener("click", () => {
			savePrefs({});
			render();
		});
		qtyInput?.addEventListener("input", render);
		// Another tab changed prefs.
		addEventListener("storage", (e) => (e.key === PREFS_KEY || e.key === INVENTORY_KEY) && render());

		// Static HTML shows defaults; only re-render if saved choices or inventory affect this tree.
		if (usesCustomRecipes(graph, root, loadPrefs()) || Object.keys(loadHave()).some((s) => s in graph)) render();
	}
</script>

<style>
	.crumbs {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 1rem;
		color: var(--text-dim);
	}
	.crumbs a {
		color: var(--text-dim);
	}
	.item-head {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
	}
	.item-icon {
		display: grid;
		place-items: center;
		width: 96px;
		height: 96px;
		flex: none;
		background: radial-gradient(circle at 50% 40%, #2c2a24, var(--bg-sunk));
		border: 1px solid var(--line-strong);
		border-radius: 12px;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}
	.tags a {
		color: var(--text-dim);
	}
	.plan-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		margin-top: 0.8rem;
	}
	.qty-field {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.85rem;
		color: var(--text-dim);
	}
	.qty-field input {
		width: 5.5rem;
	}
	.unlocks {
		margin: 0.6rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.9rem;
	}
	.unlocks strong {
		color: var(--gold);
		font-weight: 600;
	}
	.flavour {
		margin: 0.6rem 0 0;
		font-family: var(--serif);
		font-style: italic;
		color: var(--text-dim);
	}
	.power {
		color: var(--gold);
		border-color: var(--gold-dim);
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
		gap: 0.5rem;
		margin: 0;
	}
	.stats div {
		padding: 0.5rem 0.75rem;
		background: var(--bg-raised);
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	.stats dt {
		font-size: 0.75rem;
		color: var(--text-dim);
	}
	.stats dd {
		margin: 0.1rem 0 0;
		font-weight: 600;
	}
	.extract {
		max-width: 70ch;
		margin: 1.25rem 0 0;
	}
	.recipes {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
		gap: 1rem;
	}
	.variant {
		margin: 0 0 0.3rem;
	}
	h3 {
		margin: 1.5rem 0 0.5rem;
		font-size: 1.05rem;
	}
</style>
