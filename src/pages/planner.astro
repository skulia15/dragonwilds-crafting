---
import Base from "../layouts/Base.astro";
import { items } from "../lib/db";
import "../styles/tree.css";

const craftable = items.filter((i) => i.recipes.length).map((i) => ({ name: i.name, slug: i.slug }));
---

<Base
	title="Crafting Planner — Combined Shopping List | Dragonwilds"
	description="Plan several RuneScape: Dragonwilds crafts at once and get one combined list of raw materials and crafting steps."
>
	<h1>Crafting planner</h1>
	<p class="muted">
		Add everything you want to craft. You get one shopping list of raw materials and the crafting steps in order.
		Saved in this browser.
	</p>

	<form class="adder" id="planner-add">
		<label class="visually-hidden" for="planner-item">Item</label>
		<div class="suggest-wrap">
			<input
				id="planner-item"
				role="combobox"
				aria-expanded="false"
				aria-controls="planner-suggest"
				aria-autocomplete="list"
				placeholder="Add an item… e.g. Bronze Helmet"
				autocomplete="off"
			/>
			<ul id="planner-suggest" role="listbox" hidden></ul>
		</div>
		<label class="visually-hidden" for="planner-qty">Quantity</label>
		<input type="number" id="planner-qty" min="1" max="9999" value="1" inputmode="numeric" />
		<button class="btn" type="submit">Add</button>
		<span class="small muted" id="planner-msg" aria-live="polite"></span>
	</form>
	<script type="application/json" id="planner-names" set:html={JSON.stringify(craftable).replace(/</g, "\\u003c")} />

	<p class="muted" id="planner-empty">Your plan is empty. Add items above, or use “Add to planner” on any item page.</p>

	<div id="planner-body" hidden>
		<section>
			<h2 class="list-head">Your plan <button class="btn ghost small" type="button" id="planner-clear">Clear all</button></h2>
			<ul class="plan-list" id="planner-list"></ul>
		</section>
		<section class="cols" id="planner-lists">
			<div>
				<h2 class="list-head">
					Shopping list <button type="button" class="btn ghost small" id="planner-copy">Copy list</button>
				</h2>
				<p class="small muted" id="planner-summary"></p>
				<ul class="totals" id="planner-raw"></ul>
			</div>
			<div>
				<h2>Crafting steps</h2>
				<p class="small muted">In order — ingredients first. Uses your saved recipe choices; enter what you already have to skip it.</p>
				<ol class="steps" id="planner-steps"></ol>
			</div>
		</section>
		<p class="small muted" id="planner-inventory-note" hidden>
			Counting what you have — shared with item pages.{" "}
			<button type="button" class="link-btn" id="planner-inventory-reset">Clear inventory</button>
		</p>
	</div>
</Base>

<script>
	import { bindInventory, copyText, INVENTORY_KEY, loadHave, saveHave } from "../lib/inventory";
	import { clampQty, loadPlanner, PLANNER_KEY, savePlanner } from "../lib/planner";
	import { loadPrefs } from "../lib/prefs";
	import { gatherSummary, type Graph, plan, planText, renderRaw, renderSteps } from "../lib/tree";
	import { href, iconUrl } from "../lib/wiki";

	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
	const names = JSON.parse($("planner-names").textContent!) as { name: string; slug: string }[];
	const bySlugName = new Map(names.map((n) => [n.name.toLowerCase(), n.slug]));
	let graph: Graph | null = null;

	const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
	const icon = (file: string | null) =>
		file ? `<img class="icon" src="${iconUrl(file)}" alt="" width="28" height="28" loading="lazy">` : "";
	const link = (slug: string) => `<a href="${href(`/item/${slug}/`)}">${esc(graph![slug].name)}</a>`;

	function render() {
		const list = loadPlanner().filter((e) => graph![e.slug]);
		$("planner-empty").hidden = list.length > 0;
		$("planner-body").hidden = list.length === 0;
		if (!list.length) return;

		$("planner-list").innerHTML = list
			.map(
				(e) => `<li>${icon(graph![e.slug].icon)}${link(e.slug)}
				<input type="number" min="1" max="9999" value="${e.qty}" data-slug="${e.slug}" aria-label="Quantity of ${esc(graph![e.slug].name)}">
				<button type="button" class="btn ghost" data-remove="${e.slug}" aria-label="Remove ${esc(graph![e.slug].name)}">✕</button></li>`,
			)
			.join("");

		const have = loadHave();
		const { raw, steps } = plan(graph!, list, loadPrefs(), have);
		$("planner-summary").innerHTML = gatherSummary(graph!, raw);
		$("planner-raw").innerHTML = renderRaw(graph!, raw, have);
		$("planner-steps").innerHTML = renderSteps(graph!, steps, have);
		$("planner-inventory-note").hidden = Object.keys(have).length === 0;
	}

	const currentPlan = () => plan(graph!, loadPlanner().filter((e) => graph![e.slug]), loadPrefs(), loadHave());
	bindInventory($("planner-lists"), () => graph && render());
	$("planner-inventory-reset").addEventListener("click", () => {
		saveHave({});
		render();
	});
	const copyBtn = $("planner-copy");
	copyBtn.addEventListener("click", () => {
		const title = loadPlanner()
			.filter((e) => graph![e.slug])
			.map((e) => `${e.qty}× ${graph![e.slug].name}`)
			.join(", ");
		copyText(planText(graph!, `Dragonwilds plan: ${title}`, currentPlan()), copyBtn);
	});

	// Lightweight suggestions (a 1k-option <datalist> is sluggish and awkward on phones).
	const itemInput = $<HTMLInputElement>("planner-item");
	const suggest = $("planner-suggest");
	const showSuggestions = () => {
		const q = itemInput.value.trim().toLowerCase();
		const hits = q
			? names
					.filter((n) => n.name.toLowerCase().includes(q))
					.sort((a, b) => Number(!a.name.toLowerCase().startsWith(q)) - Number(!b.name.toLowerCase().startsWith(q)))
					.slice(0, 8)
			: [];
		suggest.innerHTML = hits.map((h) => `<li role="option"><button type="button">${esc(h.name)}</button></li>`).join("");
		suggest.hidden = hits.length === 0;
		itemInput.setAttribute("aria-expanded", String(!suggest.hidden));
	};
	itemInput.addEventListener("input", showSuggestions);
	itemInput.addEventListener("keydown", (e) => e.key === "Escape" && (suggest.hidden = true));
	suggest.addEventListener("click", (e) => {
		const button = (e.target as HTMLElement).closest("button");
		if (!button) return;
		itemInput.value = button.textContent!;
		suggest.hidden = true;
		$<HTMLInputElement>("planner-qty").focus();
	});
	document.addEventListener("click", (e) => {
		if (!(e.target as HTMLElement).closest(".suggest-wrap")) suggest.hidden = true;
	});

	const msg = $("planner-msg");
	$("planner-add").addEventListener("submit", (e) => {
		e.preventDefault();
		const input = $<HTMLInputElement>("planner-item");
		const slug = bySlugName.get(input.value.trim().toLowerCase());
		if (!slug) {
			msg.textContent = "Pick an item from the list.";
			return;
		}
		const list = loadPlanner();
		const qty = clampQty($<HTMLInputElement>("planner-qty").value);
		const existing = list.find((x) => x.slug === slug);
		if (existing) existing.qty += qty;
		else list.push({ slug, qty });
		savePlanner(list);
		input.value = "";
		suggest.hidden = true;
		msg.textContent = "";
		render();
	});
	$("planner-list").addEventListener("change", (e) => {
		const input = e.target as HTMLInputElement;
		if (!input.dataset.slug) return;
		savePlanner(loadPlanner().map((x) => (x.slug === input.dataset.slug ? { ...x, qty: clampQty(input.value) } : x)));
		render();
	});
	$("planner-list").addEventListener("click", (e) => {
		const slug = (e.target as HTMLElement).closest<HTMLElement>("[data-remove]")?.dataset.remove;
		if (!slug) return;
		savePlanner(loadPlanner().filter((x) => x.slug !== slug));
		render();
	});
	$("planner-clear").addEventListener("click", () => {
		savePlanner([]);
		render();
	});
	addEventListener("storage", (e) => (e.key === PLANNER_KEY || e.key === INVENTORY_KEY) && graph && render());

	// One fetch of every recipe; only the planner needs it.
	fetch(href("/graph.json"))
		.then((r) => r.json() as Promise<Graph>)
		.then((g) => {
			graph = g;
			render();
		});
</script>

<style>
	.adder {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
		margin: 1.5rem 0;
	}
	.suggest-wrap {
		position: relative;
		flex: 1 1 260px;
	}
	#planner-suggest {
		position: absolute;
		z-index: 5;
		top: calc(100% + 4px);
		left: 0;
		right: 0;
		margin: 0;
		padding: 0.25rem;
		list-style: none;
		background: var(--bg-raised);
		border: 1px solid var(--line-strong);
		border-radius: 6px;
		box-shadow: 0 10px 24px rgb(0 0 0 / 0.45);
	}
	#planner-suggest :global(button) {
		width: 100%;
		min-height: 40px;
		padding: 0.4rem 0.6rem;
		font: inherit;
		text-align: left;
		color: var(--text);
		background: none;
		border: none;
		border-radius: 4px;
		cursor: pointer;
	}
	#planner-suggest :global(button:hover) {
		background: #2a2e35;
	}
	#planner-item {
		width: 100%;
		padding: 0.55rem 0.8rem;
		font: inherit;
		font-size: max(16px, 1em);
		color: var(--text);
		background: var(--bg-sunk);
		border: 1px solid var(--line-strong);
		border-radius: 6px;
	}
	#planner-qty {
		width: 5.5rem;
	}
	.plan-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.plan-list :global(li) {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.4rem 0;
		border-bottom: 1px solid var(--line);
	}
	.plan-list :global(a) {
		flex: 1;
	}
	.plan-list :global(input) {
		width: 5rem;
	}
</style>
