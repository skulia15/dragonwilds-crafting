---
import ItemCard from "../components/ItemCard.astro";
import ItemIcon from "../components/ItemIcon.astro";
import Search from "../components/Search.astro";
import Base from "../layouts/Base.astro";
import { categories, items } from "../lib/db";
import { href } from "../lib/wiki";

// Representative icon per category: its most-used craftable item, else the first one.
const iconFor = (slug: string) => {
	const members = items.filter((i) => i.category === slug && i.icon);
	const craftable = members.filter((i) => i.recipes.length);
	const pool = craftable.length ? craftable : members;
	return pool.reduce((best, i) => (i.usedIn.length > best.usedIn.length ? i : best), pool[0])?.icon ?? null;
};
const stations = items.filter((i) => i.category === "crafting-stations");
const craftableCount = items.filter((i) => i.recipes.length).length;
// ≤70 chars: Bing/Google truncate longer titles.
const title = "Dragonwilds Crafting — Recipes & Crafting Trees for RS Dragonwilds";
const description = `Search ${craftableCount} RuneScape: Dragonwilds crafting recipes. See materials, crafting stations, full crafting trees and where to find every resource.`;
const pageUrl = new URL(href("/"), Astro.site).href;
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${pageUrl}#website`,
			url: pageUrl,
			name: "Dragonwilds Crafting",
			description,
			inLanguage: "en",
			publisher: { "@id": `${pageUrl}#author` },
		},
		{
			"@type": "Person",
			"@id": `${pageUrl}#author`,
			name: "Skúli Arnarsson",
		},
		{
			"@type": "ItemList",
			name: "Dragonwilds crafting categories",
			numberOfItems: categories.length,
			itemListElement: categories.map((category, index) => ({
				"@type": "ListItem",
				position: index + 1,
				name: category.name,
				url: new URL(href(`/category/${category.slug}/`), Astro.site).href,
			})),
		},
	],
};
---

<Base
	title={title}
	description={description}
	structuredData={structuredData}
	hideSearch
>
	<section class="hero">
		<h1>What do you want to craft?</h1>
		<p class="muted">
			Recipes, stations and full material trees for {craftableCount} items in RuneScape: Dragonwilds.
		</p>
		<Search large autofocus />
	</section>

	<section>
		<h2>Browse by category</h2>
		<div class="categories">
			{
				categories.map((c) => (
					<a class="card-link" href={href(`/category/${c.slug}/`)}>
						<ItemIcon file={iconFor(c.slug)} size={40} />
						<span>
							<span class="name">{c.name}</span>
							<span class="sub">{c.craftable ? `${c.craftable} craftable` : `${c.count} items`}</span>
						</span>
					</a>
				))
			}
		</div>
	</section>

	<section>
		<h2>Crafting stations</h2>
		<div class="grid">
			{stations.map((s) => <ItemCard item={s} sub={undefined} />)}
		</div>
	</section>
</Base>

<style>
	.hero {
		max-width: 640px;
		margin: 3rem auto 1rem;
		text-align: center;
	}
	.hero p {
		margin: 0.5rem 0 1.5rem;
	}
	.hero :global(.search) {
		text-align: left;
	}
	.categories {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 0.6rem;
	}
</style>
